// Sistema de gestión hotelera — esquema de datos multi-tenant (hotelId en cada tabla de negocio)
// Ver docs/02-arquitectura.md para las decisiones de diseño.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy / identidad
// ---------------------------------------------------------------------------

model Hotel {
  id        String   @id @default(cuid())
  name      String
  country   String   @default("AR")
  currency  String   @default("ARS")
  timezone  String   @default("America/Argentina/Buenos_Aires")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  guests            Guest[]
  roomTypes         RoomType[]
  rooms             Room[]
  ratePlans         RatePlan[]
  rates             Rate[]
  channels          Channel[]
  reservations      Reservation[]
  payments          Payment[]
  services          Service[]
  consumptions      Consumption[]
  cashSessions      CashSession[]
  cashMovements     CashMovement[]
  housekeepingTasks HousekeepingTask[]
  maintenanceTasks  MaintenanceTask[]
  auditLogs         AuditLog[]
  dailyMetrics      DailyHotelMetric[]
  goals             Goal[]
}

model Role {
  id          String  @id @default(cuid())
  code        String  @unique // ADMIN | GERENTE | RECEPCION | HOUSEKEEPING | MANTENIMIENTO
  name        String
  description String?

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String @id @default(cuid())
  code        String @unique // ej: reservations.create, cash.close
  description String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id           String   @id @default(cuid())
  hotelId      String
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  roleId       String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])
  role  Role  @relation(fields: [roleId], references: [id])

  reservationsCreated       Reservation[]      @relation("ReservationCreatedBy")
  payments                  Payment[]
  consumptionsRegistered    Consumption[]
  cashSessionsOpened        CashSession[]      @relation("CashSessionOpenedBy")
  cashSessionsClosed        CashSession[]      @relation("CashSessionClosedBy")
  cashMovements             CashMovement[]
  housekeepingTasksAssigned HousekeepingTask[] @relation("HousekeepingAssignedTo")
  maintenanceTasksAssigned  MaintenanceTask[]  @relation("MaintenanceAssignedTo")
  auditLogs                 AuditLog[]
  goalsCreated              Goal[]

  @@index([hotelId])
}

// ---------------------------------------------------------------------------
// Huéspedes
// ---------------------------------------------------------------------------

model Guest {
  id             String    @id @default(cuid())
  hotelId        String
  firstName      String
  lastName       String
  documentType   String    @default("DNI")
  documentNumber String
  nationality    String?
  birthDate      DateTime? @db.Date
  phone          String?
  email          String?
  address        String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])

  reservationsAsTitular Reservation[]      @relation("ReservationTitular")
  reservationGuests     ReservationGuest[]

  @@unique([hotelId, documentType, documentNumber])
  @@index([hotelId, lastName])
}

// ---------------------------------------------------------------------------
// Habitaciones
// ---------------------------------------------------------------------------

model RoomType {
  id          String   @id @default(cuid())
  hotelId     String
  name        String
  description String?
  capacity    Int
  basePrice   Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel        Hotel              @relation(fields: [hotelId], references: [id])
  rooms        Room[]
  rates        Rate[]
  dailyMetrics DailyHotelMetric[]

  @@unique([hotelId, name])
}

enum RoomStatus {
  DISPONIBLE
  OCUPADA
  RESERVADA
  LIMPIEZA
  MANTENIMIENTO
  FUERA_DE_SERVICIO
}

model Room {
  id         String     @id @default(cuid())
  hotelId    String
  roomTypeId String
  number     String
  floor      String?
  beds       String?
  features   String?
  status     RoomStatus @default(DISPONIBLE)
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  hotel    Hotel    @relation(fields: [hotelId], references: [id])
  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  reservations      Reservation[]
  housekeepingTasks HousekeepingTask[]
  maintenanceTasks  MaintenanceTask[]

  @@unique([hotelId, number])
}

// ---------------------------------------------------------------------------
// Tarifas
// ---------------------------------------------------------------------------

model RatePlan {
  id                String  @id @default(cuid())
  hotelId           String
  name              String
  refundable        Boolean @default(true)
  includesBreakfast Boolean @default(false)
  description       String?
  active            Boolean @default(true)

  hotel        Hotel         @relation(fields: [hotelId], references: [id])
  rates        Rate[]
  reservations Reservation[]

  @@unique([hotelId, name])
}

model Rate {
  id         String   @id @default(cuid())
  hotelId    String
  ratePlanId String
  roomTypeId String
  price      Decimal  @db.Decimal(12, 2)
  validFrom  DateTime @db.Date
  validTo    DateTime @db.Date
  createdAt  DateTime @default(now())

  hotel    Hotel    @relation(fields: [hotelId], references: [id])
  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id])
  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  reservations Reservation[]

  @@index([hotelId, roomTypeId, validFrom, validTo])
}

// ---------------------------------------------------------------------------
// Canales de venta
// ---------------------------------------------------------------------------

model Channel {
  id            String  @id @default(cuid())
  hotelId       String
  code          String // DIRECTO | WEB | WHATSAPP | BOOKING | EXPEDIA | AGENCIA | EMPRESA | OTRO
  name          String
  commissionPct Decimal @default(0) @db.Decimal(5, 2) // % de comisión sobre el ingreso bruto
  active        Boolean @default(true)

  hotel        Hotel         @relation(fields: [hotelId], references: [id])
  reservations Reservation[]

  @@unique([hotelId, code])
}

// ---------------------------------------------------------------------------
// Servicios y consumos
// ---------------------------------------------------------------------------

enum ServiceCategory {
  DESAYUNO
  RESTAURANTE
  BAR
  MINIBAR
  ESTACIONAMIENTO
  LAVANDERIA
  EXCURSION
  OTRO
}

model Service {
  id       String          @id @default(cuid())
  hotelId  String
  name     String
  category ServiceCategory @default(OTRO)
  price    Decimal         @db.Decimal(12, 2)
  active   Boolean         @default(true)

  hotel        Hotel         @relation(fields: [hotelId], references: [id])
  consumptions Consumption[]

  @@unique([hotelId, name])
}

model Consumption {
  id             String   @id @default(cuid())
  hotelId        String
  reservationId  String
  serviceId      String
  quantity       Int      @default(1)
  unitPrice      Decimal  @db.Decimal(12, 2) // snapshot del precio del servicio al momento de cargarlo
  date           DateTime @default(now())
  notes          String?
  registeredById String
  createdAt      DateTime @default(now())

  hotel        Hotel       @relation(fields: [hotelId], references: [id])
  reservation  Reservation @relation(fields: [reservationId], references: [id])
  service      Service     @relation(fields: [serviceId], references: [id])
  registeredBy User        @relation(fields: [registeredById], references: [id])

  @@index([hotelId, reservationId])
}

// ---------------------------------------------------------------------------
// Reservas
// ---------------------------------------------------------------------------

enum ReservationStatus {
  CONSULTA
  PRE_RESERVA
  CONFIRMADA
  CHECK_IN
  CHECK_OUT
  CANCELADA
  NO_SHOW
}

model Reservation {
  id                  String            @id @default(cuid())
  hotelId             String
  titularGuestId      String
  roomId              String
  ratePlanId          String?
  rateId              String?
  checkInDate         DateTime          @db.Date // fecha prevista de entrada
  checkOutDate        DateTime          @db.Date // fecha prevista de salida
  actualCheckInAt     DateTime? // momento real del check-in
  actualCheckOutAt    DateTime? // momento real del check-out
  guestsCount         Int               @default(1)
  status              ReservationStatus @default(CONSULTA)
  channelId           String
  agreedPricePerNight Decimal           @db.Decimal(12, 2)
  notes               String?
  createdById         String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  hotel        Hotel     @relation(fields: [hotelId], references: [id])
  titularGuest Guest     @relation("ReservationTitular", fields: [titularGuestId], references: [id])
  room         Room      @relation(fields: [roomId], references: [id])
  ratePlan     RatePlan? @relation(fields: [ratePlanId], references: [id])
  rate         Rate?     @relation(fields: [rateId], references: [id])
  channel      Channel   @relation(fields: [channelId], references: [id])
  createdBy    User      @relation("ReservationCreatedBy", fields: [createdById], references: [id])

  guests       ReservationGuest[]
  payments     Payment[]
  consumptions Consumption[]

  @@index([hotelId, roomId, checkInDate, checkOutDate])
  @@index([hotelId, status])
}

model ReservationGuest {
  id            String  @id @default(cuid())
  reservationId String
  guestId       String
  isTitular     Boolean @default(false)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guest       Guest       @relation(fields: [guestId], references: [id])

  @@unique([reservationId, guestId])
}

// ---------------------------------------------------------------------------
// Pagos
// ---------------------------------------------------------------------------

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  OTRO
}

enum PaymentType {
  SENA
  PARCIAL
  FINAL
  DEVOLUCION
}

model Payment {
  id             String        @id @default(cuid())
  hotelId        String
  reservationId  String
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  type           PaymentType
  notes          String?
  registeredById String
  createdAt      DateTime      @default(now())

  hotel        Hotel       @relation(fields: [hotelId], references: [id])
  reservation  Reservation @relation(fields: [reservationId], references: [id])
  registeredBy User        @relation(fields: [registeredById], references: [id])

  cashMovement CashMovement?

  @@index([hotelId, reservationId])
}

// ---------------------------------------------------------------------------
// Caja
// ---------------------------------------------------------------------------

enum CashSessionStatus {
  ABIERTA
  CERRADA
}

model CashSession {
  id            String            @id @default(cuid())
  hotelId       String
  openedById    String
  openedAt      DateTime          @default(now())
  openingAmount Decimal           @db.Decimal(12, 2)
  closedById    String?
  closedAt      DateTime?
  closingAmount Decimal?          @db.Decimal(12, 2)
  status        CashSessionStatus @default(ABIERTA)
  notes         String?

  hotel     Hotel          @relation(fields: [hotelId], references: [id])
  openedBy  User           @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  closedBy  User?          @relation("CashSessionClosedBy", fields: [closedById], references: [id])
  movements CashMovement[]

  @@index([hotelId, status])
}

enum CashMovementType {
  INGRESO
  EGRESO
}

model CashMovement {
  id             String           @id @default(cuid())
  hotelId        String
  cashSessionId  String
  type           CashMovementType
  concept        String
  amount         Decimal          @db.Decimal(12, 2)
  method         PaymentMethod    @default(EFECTIVO)
  paymentId      String?          @unique
  registeredById String
  createdAt      DateTime         @default(now())

  hotel        Hotel       @relation(fields: [hotelId], references: [id])
  cashSession  CashSession @relation(fields: [cashSessionId], references: [id])
  payment      Payment?    @relation(fields: [paymentId], references: [id])
  registeredBy User        @relation(fields: [registeredById], references: [id])

  @@index([hotelId, cashSessionId])
}

// ---------------------------------------------------------------------------
// Housekeeping
// ---------------------------------------------------------------------------

enum HousekeepingStatus {
  PENDIENTE
  EN_PROCESO
  LIMPIA
  INSPECCIONADA
  CON_PROBLEMA
}

model HousekeepingTask {
  id           String             @id @default(cuid())
  hotelId      String
  roomId       String
  status       HousekeepingStatus @default(PENDIENTE)
  assignedToId String?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  completedAt  DateTime?

  hotel      Hotel @relation(fields: [hotelId], references: [id])
  room       Room  @relation(fields: [roomId], references: [id])
  assignedTo User? @relation("HousekeepingAssignedTo", fields: [assignedToId], references: [id])

  @@index([hotelId, status])
  @@index([hotelId, roomId])
}

// ---------------------------------------------------------------------------
// Mantenimiento
// ---------------------------------------------------------------------------

enum MaintenancePriority {
  BAJA
  MEDIA
  ALTA
}

enum MaintenanceStatus {
  PENDIENTE
  EN_PROCESO
  RESUELTO
}

model MaintenanceTask {
  id           String              @id @default(cuid())
  hotelId      String
  roomId       String
  issue        String
  priority     MaintenancePriority @default(MEDIA)
  status       MaintenanceStatus   @default(PENDIENTE)
  assignedToId String?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  resolvedAt   DateTime?

  hotel      Hotel @relation(fields: [hotelId], references: [id])
  room       Room  @relation(fields: [roomId], references: [id])
  assignedTo User? @relation("MaintenanceAssignedTo", fields: [assignedToId], references: [id])

  @@index([hotelId, status])
  @@index([hotelId, roomId])
}

// ---------------------------------------------------------------------------
// Auditoría
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  hotelId    String
  userId     String?
  action     String // ej: "reservation.create"
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id])
  user  User? @relation(fields: [userId], references: [id])

  @@index([hotelId, entityType, entityId])
  @@index([hotelId, createdAt])
}

// ---------------------------------------------------------------------------
// Gestión / BI: agregación diaria de KPIs y objetivos
// ---------------------------------------------------------------------------

/// Tabla de agregación diaria (hotelId, date, roomTypeId?) — la capa de KPIs
/// nunca recalcula sobre reservas/pagos en crudo. roomTypeId = null representa
/// el agregado de todo el hotel. Sin @@unique compuesto porque Postgres trata
/// NULL como distinto en índices únicos (dos filas con roomTypeId = null no
/// violarían la constraint); en su lugar, MetricsService recalcula un rango
/// completo con "borrar e insertar" en una transacción.
model DailyHotelMetric {
  id             String   @id @default(cuid())
  hotelId        String
  date           DateTime @db.Date
  roomTypeId     String?
  totalRooms     Int
  soldRoomNights Int
  roomRevenue    Decimal  @db.Decimal(12, 2)
  otherRevenue   Decimal  @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt

  hotel    Hotel     @relation(fields: [hotelId], references: [id])
  roomType RoomType? @relation(fields: [roomTypeId], references: [id])

  @@index([hotelId, date])
  @@index([hotelId, roomTypeId, date])
}

enum GoalMetric {
  OCUPACION
  ADR
  REVPAR
  INGRESOS
  CANCELACIONES
  VENTA_DIRECTA_PCT
}

model Goal {
  id          String     @id @default(cuid())
  hotelId     String
  metric      GoalMetric
  periodStart DateTime   @db.Date
  periodEnd   DateTime   @db.Date
  targetValue Decimal    @db.Decimal(14, 2)
  notes       String?
  createdById String
  createdAt   DateTime   @default(now())

  hotel     Hotel @relation(fields: [hotelId], references: [id])
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([hotelId, metric, periodStart])
}
